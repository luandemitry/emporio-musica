# Copy to .env and fill in. A free key comes from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.8-flash        # stable + free tier; gemini-3.5-flash-lite is a lighter alternative
# EMPORIO_NOW=2026-02-20T10:00         # freeze the clock (store local time) for reproducible demos
# EMPORIO_SESSIONS_DIR=.sessions
# EMPORIO_HANDOFF_LOG=.handoffs/handoffs.jsonl
